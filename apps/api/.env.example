# Local/self-hosted process binding. Vercel supplies its own runtime port.
PORT=3001
HOST=0.0.0.0
# Stable API/Auth/Content/Realm origins and the publication pointer are owned by @arsvine/site-config.
CORE_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
CONTENT_PUBLISH_TOKEN=replace-with-a-long-random-internal-publish-token
REVALIDATE_WEBHOOK_SECRET=replace-with-a-long-random-secret
