# Local/self-hosted process binding. Vercel supplies its own runtime port.
PORT=3001
HOST=0.0.0.0
API_DISPLAY_NAME=Arsvine Control API
API_PUBLIC_URL=https://api.arsvine.com
AUTH_ISSUER=https://auth.arsvine.com
AUTH_JWKS_URL=https://auth.arsvine.com/jwks
API_RESOURCE=https://api.arsvine.com
CORE_DATABASE_URL=postgresql://user:password@host/database
CONTENT_CURRENT_POINTER=realm-content/current.json
CONTENT_PUBLISH_URL=https://content.arsvine.com/v1/internal/publications
CONTENT_PUBLISH_TOKEN=replace-with-the-content-publish-token
REALM_REVALIDATE_URL=https://arsvine.com/api/internal/revalidate
REVALIDATE_WEBHOOK_SECRET=replace-with-a-long-random-secret
