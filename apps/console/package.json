{
  "name": "arsvine-admin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path config/prettier.ignore --log-level warn",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path config/prettier.ignore --log-level warn",
    "check:unused": "knip --config config/knip.jsonc --no-progress",
    "check:duplicates": "jscpd --config config/jscpd.json",
    "quality": "pnpm check:unused && pnpm check:duplicates",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "hash-password": "node scripts/generate-password-hash.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm quality && pnpm test && pnpm build"
  },
  "prettier": "./config/prettier.json",
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@mdxeditor/editor": "4.2.4",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.1",
    "@types/pg": "^8.23.1",
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.20.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "redis": "^6.2.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "jscpd": "5.2.0",
    "knip": "6.35.1",
    "postcss": "^8.5.23",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
