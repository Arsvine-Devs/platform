{
  "name": "arsvine-admin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint -c ../../config/oxlint.json . && pnpm run lint:eslint",
    "lint:eslint": "eslint . --max-warnings 0",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path config/prettier.ignore --log-level warn",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path config/prettier.ignore --log-level warn",
    "check:unused": "knip --config config/knip.jsonc --no-progress",
    "check:duplicates": "jscpd --config config/jscpd.json",
    "quality": "pnpm check:unused && pnpm check:duplicates",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm quality && pnpm test && pnpm build"
  },
  "prettier": "./config/prettier.json",
  "dependencies": {
    "@arsvine/contracts": "workspace:*",
    "@arsvine/env": "workspace:*",
    "@arsvine/service-health": "workspace:*",
    "@arsvine/site-config": "workspace:*",
    "@base-ui/react": "^1.5.0",
    "@mdxeditor/editor": "4.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.20.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "@ui-sdk/core": "0.1.0-beta.10",
    "@ui-sdk/react": "0.1.0-beta.10",
    "geist": "1.9.2",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-oxlint": "1.82.0",
    "jscpd": "5.2.0",
    "knip": "6.35.1",
    "oxlint": "1.82.0",
    "postcss": "^8.5.23",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  }
}
