# Host-only Console session encryption/signing key.
SESSION_SECRET=replace-with-a-random-long-string

# Auth OIDC endpoint URLs, resources, scope, and Console callback origins are owned by @arsvine/site-config.
AUTH_OIDC_CLIENT_ID=console-client-id
AUTH_OIDC_CLIENT_SECRET=console-client-secret

# Upstash Redis-backed OIDC sessions and distributed rate limiting.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token

# Only enable when the hosting proxy overwrites forwarded client headers.
TRUST_PROXY=0

# Optional Vercel Analytics configuration.
NEXT_PUBLIC_ANALYTICS_ENABLED=0
NEXT_PUBLIC_ANALYTICS_SCRIPT_ORIGIN=https://va.vercel-scripts.com
NEXT_PUBLIC_ANALYTICS_CONNECT_ORIGIN=https://vitals.vercel-insights.com
