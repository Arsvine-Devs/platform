# Legacy owner workspace bootstrap only. On first Owner initialization these values are encrypted into
# that Owner's private workspace. Do not use them as regular runtime configuration afterwards.
# GITHUB_OWNER=Arsvine-Realm-Dev-Team
# GITHUB_REPO=arsvine-content
# GITHUB_BRANCH=main
# GITHUB_WRITE_TOKEN=github_pat_xxx
# Provider endpoints. Keep these outside business logic so compatible providers
# and deployment domains can be changed without a code edit.
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_WEB_BASE_URL=https://github.com
# X_API_BASE_URL=https://api.x.com/2
# X_WEB_BASE_URL=https://x.com
# NEXT_PUBLIC_GITHUB_TOKEN_URL=https://github.com/settings/personal-access-tokens/new
# NEXT_PUBLIC_ANALYTICS_ENABLED=0
# NEXT_PUBLIC_ANALYTICS_SCRIPT_ORIGIN=https://va.vercel-scripts.com
# NEXT_PUBLIC_ANALYTICS_CONNECT_ORIGIN=https://vitals.vercel-insights.com

# Signed admin session and CSRF state
# SESSION_SECRET=replace-with-a-random-long-string

# PostgreSQL connection using the standard wire protocol. Neon may remain the
# hosted provider while the application uses the ordinary PostgreSQL driver.
# DATABASE_URL=postgresql://...
# The first account created from the existing admin credentials is the unique Owner.
# OWNER_ADMIN_EMAIL=owner@example.com
# 32 random bytes encoded as base64url. Keep this stable after members configure secrets.
# WORKSPACE_SECRETS_ENCRYPTION_KEY=...

# One-time Owner migration credentials. The first Owner is bootstrapped from
# these values; after the Owner registers a security key, remove these values
# from production so Owner login no longer accepts password/TOTP.
# Keep `\$` as-is in `.env.local`, otherwise Next will expand `$...`.
# ADMIN_PASSWORD_HASH=scrypt\$base64url-salt\$base64url-hash

# Dedicated one-time Owner migration TOTP config. Editor TOTP secrets are
# generated during invitation activation and stored encrypted in Postgres.
# ADMIN_TOTP_JSON={"current":"JBSWY3DPEHPK3PXP","period":30,"digits":6,"window":1}

# FIDO2/WebAuthn Owner authentication. Use the exact production HTTPS origin;
# do not derive this from request Host headers. Vercel preview deployments use
# Vercel Authentication and are not WebAuthn login origins.
# WEBAUTHN_RP_ID=ctrl.arsvine.com
# WEBAUTHN_ORIGIN=https://ctrl.arsvine.com
# WEBAUTHN_RP_NAME=ARSVINE Admin

# Trust the X-Forwarded-For header for client identification (rate limiting,
# logging). Only enable when the app sits behind a reverse proxy that strips
# / overwrites the header — Vercel does this automatically. When unset, the
# rate limiter falls back to the runtime-provided socket IP, which cannot be
# spoofed by callers.
# TRUST_PROXY=0

# Local-only UI preview login. Both flags must be set to 1 in a development
# shell; the server rejects the bypass in every non-development environment.
# ADMIN_DEV_LOGIN_BYPASS=0
# NEXT_PUBLIC_ADMIN_DEV_LOGIN_BYPASS=0

# Redis/Valkey connection for persistent rate limiting. When unset or
# unavailable, the app falls back to a process-local Map.
# REDIS_URL=redis://localhost:6379
# Temporary compatibility for the existing Vercel Upstash REST integration;
# remove these after REDIS_URL is available in the deployment environment.
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=upstash-rest-token

# Public site revalidate endpoints
# Public blog revalidate endpoint (POST, body { secret, slug? })
# PUBLIC_REVALIDATE_URL=https://www.example.com/api/revalidate-content
# Public tweets revalidate endpoint (GET, ?secret=...)
# PUBLIC_TWEETS_REVALIDATE_URL=https://www.example.com/api/revalidate
# Shared secret; must match what the public site expects.
# PUBLIC_REVALIDATE_SECRET=replace-with-the-public-site-secret
# Vercel Cron authentication. Configure the same secret in the Admin Vercel project.
# CRON_SECRET=replace-with-a-random-long-string

# Tweet / blog auto-translation API (OpenAI-compatible; required for auto-translate / retranslate)
# AI_TRANSLATION_BASE_URL=https://api.deepseek.com/v1/
# AI_TRANSLATION_API_KEY=sk-xxxx
# AI_TRANSLATION_MODEL=deepseek-chat
# AI_TRANSLATION_THINKING=enabled
# AI_TRANSLATION_REASONING_EFFORT=high
