# Host-only Console session encryption/signing key.
SESSION_SECRET=replace-with-a-random-long-string

# Auth OIDC BFF. Production callback and issuer are exact stable origins.
AUTH_OIDC_ISSUER=https://auth.arsvine.com
AUTH_OIDC_AUTHORIZATION_URL=https://auth.arsvine.com/api/auth/oauth2/authorize
AUTH_OIDC_TOKEN_URL=https://auth.arsvine.com/api/auth/oauth2/token
AUTH_OIDC_USERINFO_URL=https://auth.arsvine.com/api/auth/oauth2/userinfo
AUTH_OIDC_JWKS_URL=https://auth.arsvine.com/jwks
AUTH_OIDC_END_SESSION_URL=https://auth.arsvine.com/api/auth/oauth2/end-session
AUTH_OIDC_CLIENT_ID=console-client-id
AUTH_OIDC_CLIENT_SECRET=console-client-secret
AUTH_OIDC_REDIRECT_URI=https://console.arsvine.com/auth/callback
AUTH_OIDC_POST_LOGOUT_REDIRECT_URI=https://console.arsvine.com/auth/signed-out
AUTH_OIDC_RESOURCE=https://api.arsvine.com
AUTH_OIDC_SCOPE=openid profile email content:read content:write content:publish
API_BASE_URL=https://api.arsvine.com

# Upstash Redis-backed OIDC sessions and distributed rate limiting.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token

# Only enable when the hosting proxy overwrites forwarded client headers.
TRUST_PROXY=0

# Optional Vercel Analytics configuration.
NEXT_PUBLIC_ANALYTICS_ENABLED=0
NEXT_PUBLIC_ANALYTICS_SCRIPT_ORIGIN=https://va.vercel-scripts.com
NEXT_PUBLIC_ANALYTICS_CONNECT_ORIGIN=https://vitals.vercel-insights.com
