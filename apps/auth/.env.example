# Stable Auth origin, issuer, audience, trusted origins, OAuth resources, and Passkey values are owned by @arsvine/site-config.
AUTH_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUSTED_ORIGINS=http://localhost:3003,https://auth.arsvine.com,https://console.arsvine.com
