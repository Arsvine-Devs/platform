    "@arsvine/service-health": "workspace:*",
    "@arsvine/site-config": "workspace:*",
    "@fastify/swagger": "^9.5.2",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist"
