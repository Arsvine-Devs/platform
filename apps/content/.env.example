# Local/self-hosted process binding. Vercel supplies its own runtime port.
PORT=3002
HOST=0.0.0.0
# Stable service origins, resource identifiers, and the publication pointer are owned by @arsvine/site-config.
S3_ENDPOINT=https://s3.example.invalid
S3_REGION=ap-beijing
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=replace-with-read-only-access-key
S3_SECRET_ACCESS_KEY=replace-with-read-only-secret
S3_PRIVATE_BUCKET=replace-with-content-bucket
CONTENT_PUBLISH_TOKEN=replace-with-a-long-random-internal-publish-token
