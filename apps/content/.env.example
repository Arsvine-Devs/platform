# Local service binding. The deployment unit supplies the production port.
PORT=3002
HOST=0.0.0.0
# Stable service origins, resource identifiers, and the publication pointer are owned by @arsvine/site-config.
CONTENT_STORAGE_ROOT=/var/lib/arsvine-web/content/production
ARS_WEB_ORIGINS={"content":"https://content.arsvine.com"}
CONTENT_PUBLISH_TOKEN=replace-with-a-long-random-internal-publish-token
