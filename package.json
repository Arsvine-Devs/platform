{
  "name": "arsvine-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter arsvine-admin dev",
    "build": "pnpm --recursive --if-present build",
    "start": "pnpm --filter arsvine-admin start",
    "lint": "oxlint -c config/oxlint.json . && pnpm --filter arsvine-admin lint:eslint",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path config/prettier.ignore --log-level warn",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path config/prettier.ignore --log-level warn",
    "check:unused": "pnpm --filter arsvine-admin check:unused && knip --config config/knip.jsonc --workspace . --workspace apps/api --workspace apps/auth --workspace apps/content --workspace packages/authz --workspace packages/contracts --workspace packages/core-db --workspace packages/object-storage --workspace packages/observability --no-progress",
    "check:duplicates": "jscpd --config config/jscpd.json",
    "quality": "pnpm check:unused && pnpm check:duplicates",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm quality && pnpm test && pnpm build",
    "compose:config": "docker compose -f infra/compose/compose.yaml config --quiet",
    "compose:up": "docker compose -f infra/compose/compose.yaml up --build",
    "compose:down": "docker compose -f infra/compose/compose.yaml down -v --remove-orphans",
    "build:services": "pnpm --recursive --if-present build"
  },
  "devDependencies": {
    "jscpd": "5.2.0",
    "knip": "6.35.1",
    "oxlint": "1.82.0",
    "prettier": "3.9.6"
  }
}
