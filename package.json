{
  "name": "arsvine-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter arsvine-admin dev",
    "build": "pnpm --recursive --if-present build",
    "start": "pnpm --filter arsvine-admin start",
    "envctl": "node packages/env/src/cli.mjs",
    "env:check": "node scripts/check-env-contract.mjs",
    "lint": "oxlint -c config/oxlint.json . && pnpm --filter arsvine-admin lint:eslint",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path config/prettier.ignore --log-level warn",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path config/prettier.ignore --log-level warn",
    "packages:sync": "node scripts/sync-site-packages.mjs",
    "packages:check": "node scripts/sync-site-packages.mjs --check",
    "docs:check": "node scripts/check-doc-links.mjs",
    "check:unused": "pnpm --filter arsvine-admin check:unused && knip --config config/knip.jsonc --workspace . --workspace apps/api --workspace apps/auth --workspace apps/content --workspace packages/authz --workspace packages/contracts --workspace packages/core-db --workspace packages/env --workspace packages/object-storage --workspace packages/observability --workspace packages/site-config --workspace packages/service-health --no-progress",
    "check:duplicates": "jscpd --config config/jscpd.json",
    "quality": "pnpm check:unused && pnpm check:duplicates",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "check": "pnpm format:check && pnpm docs:check && pnpm packages:check && pnpm env:check && pnpm lint && pnpm typecheck && pnpm quality && pnpm test && pnpm build",
    "compose:config": "docker compose -f infra/compose/compose.yaml config --quiet",
    "compose:up": "docker compose -f infra/compose/compose.yaml up --build",
    "compose:down": "docker compose -f infra/compose/compose.yaml down -v --remove-orphans",
    "build:services": "pnpm --recursive --if-present build"
  },
  "devDependencies": {
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
